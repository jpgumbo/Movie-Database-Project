-- ------------------------------------------------------------
-- Query 1 - H1: review scores and worldwide box office
-- Written by: [your name]
--
-- Returns one row per film with both aggregate scores and the worldwide
-- box office, which is calculated from its two parts because a derivable
-- value is not stored in the database. Films without a score or without
-- both box-office parts are excluded, since H1 needs all of them.
-- Result: 4,890 films
-- ------------------------------------------------------------

SELECT m.movie_id,
       m.title,
       m.metascore,
       m.userscore,
       s.domestic_box_office + s.international_box_office AS worldwide_box_office,
       s.production_budget,
       s.runtime_minutes,
       s.release_date
FROM movies m
JOIN sales s ON s.movie_id = m.movie_id
WHERE m.metascore IS NOT NULL
  AND m.userscore IS NOT NULL
  AND s.domestic_box_office IS NOT NULL
  AND s.international_box_office IS NOT NULL
ORDER BY m.movie_id;

-- ------------------------------------------------------------
-- Query 4 - Sub-question 1: rating distributions of critics and users
-- Written by: [your name]
--
-- Critics rate from 0 to 100 and users from 0 to 10, so the user scores
-- are multiplied by 10 to put both on the same scale. UNION ALL places
-- the two results in one table.
-- Result: critics mean 62.75 (sd 20.71), users 65.86 (sd 31.87)
-- ------------------------------------------------------------
SELECT 'critic' AS reviewer_type,
       COUNT(*) AS n_reviews,
       ROUND(AVG(idvscore), 2) AS mean_score,
       ROUND(STDDEV(idvscore), 2) AS sd_score,
       MIN(idvscore) AS min_score,
       MAX(idvscore) AS max_score
FROM critic_reviews
WHERE idvscore IS NOT NULL
UNION ALL
SELECT 'user',
       COUNT(*),
       ROUND(AVG(idvscore * 10), 2),
       ROUND(STDDEV(idvscore * 10), 2),
       MIN(idvscore * 10),
       MAX(idvscore * 10)
FROM user_reviews
WHERE idvscore IS NOT NULL;
